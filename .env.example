APP_NAME="Postcard Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://yourdomain.com

# Site Owner Configuration  
OWNER_NAME="Your Name"
# Receives arrival alerts; when unset, alerts are skipped (logged as a warning)
OWNER_EMAIL=
OWNER_USERNAME="your_username"
# Public "contact me" address on the home page (defaults to OWNER_EMAIL)
OWNER_CONTACT_EMAIL=
# Where your cards are sent from; shown to recipients on the arrival page
# and in the home page greeting (e.g. "Yogyakarta, Indonesia")
OWNER_LOCATION=

# Home Location (for distance calculation - keep private!)
HOME_LAT=0.000000
HOME_LNG=0.000000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC
# PHP date letters, e.g. d/m/Y or m/d/Y
APP_DATE_FORMAT=d/m/Y

# Currency postage costs are recorded and reported in (ISO 4217).
# Set this before entering data; see config/currency.php.
APP_BASE_CURRENCY=IDR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# MAP API KEYS
GOOGLE_API_KEY=
AMAP_JS_KEY=
AMAP_WEB_KEY=

# EMAIL CONFIGURATION (SMTP via HestiaCP)
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=postcrossing@yourdomain.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
# Sender for arrival alerts; required for sending
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
